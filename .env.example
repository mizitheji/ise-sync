# .env.example
# Copy this to .env, fill in real values, then: source .env
# .env is gitignored — never commit your real credentials.

# Node: hq-pan  (env_prefix: ISE_HQ)
ISE_HQ_USER=ise-api-account
ISE_HQ_PASS=change-me

# Node: dr-standalone  (env_prefix: ISE_DR)
ISE_DR_USER=ise-api-account
ISE_DR_PASS=change-me

